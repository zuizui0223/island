  "decision": {
    "full_flora_gaussian_hypervolume_inference": "not_performed",
    "reasons": [
      "Low-dimensional projections omit most of the common sqrt-distance geometry.",
      "No island satisfies the unique-profile KDE screening rule at six dimensions; 80% common inertia requires seventeen dimensions.",
      "PCoA coordinates do not turn unobserved categorical combinations into biologically observed continuous states."
    ],
    "retained_outputs": [
      "common PCoA projection with explicit inertia and distance error",
      "recorded profile counts",
      "species carriers per profile",
      "exact rarefied profile richness",
      "discrete between-island profile overlap"
    ]
  },
